# Commercial launch gates
AUTH_ENFORCEMENT_ENABLED=false
PRIVATE_STORAGE_ENABLED=false
CERTIFICATE_SIGNING_KEY_ID=
CERTIFICATE_ISSUER_ID=
LEGAL_LAUNCH_APPROVED=false
TRUST_OPERATIONS_ENABLED=false
ERROR_MONITORING_DSN=
INCIDENT_RESPONSE_ENABLED=false
