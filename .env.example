# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase configuration. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Private seller asset storage (Cloudflare R2, S3-compatible API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=verified-ai-cast-assets
STORAGE_UPLOAD_MAX_BYTES=536870912

# Launch market: KR, GLOBAL, or DUAL. Start with KR until a global entity is ready.
LAUNCH_MARKET=KR

# Korea payments: PortOne V2 orchestration with a Toss Payments channel
NEXT_PUBLIC_PORTONE_STORE_ID=
PORTONE_API_SECRET=
PORTONE_TOSS_CHANNEL_KEY=
PAYMENTS_KR_ENABLED=false

# Global payments: only for an entity in a Stripe-supported country
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_GLOBAL_ENABLED=false

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Commercial launch gates
AUTH_ENFORCEMENT_ENABLED=false
PRIVATE_STORAGE_ENABLED=false
CERTIFICATE_SIGNING_KEY_ID=
CERTIFICATE_ISSUER_ID=
LEGAL_LAUNCH_APPROVED=false
TRUST_OPERATIONS_ENABLED=false
ERROR_MONITORING_DSN=
INCIDENT_RESPONSE_ENABLED=false
